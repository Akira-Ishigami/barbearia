# ============================================================
# Navalha — variáveis de ambiente
#
# Copie para `.env.local` (já ignorado pelo git) e preencha.
# Na Vercel: Settings → Environment Variables, os mesmos nomes.
#
# NUNCA comite os valores reais. Nunca mande por chat/e-mail.
# ============================================================

# URL pública da aplicação. Em dev: http://localhost:3000
# Na Vercel: https://navalha-virid.vercel.app (sem barra no fim)
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ---------- Supabase ----------
# Painel do Supabase → Project Settings → API

# Pode aparecer no navegador
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SEGREDO — ignora RLS e enxerga tudo. Só nas rotas de API,
# nunca com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=


# ---------- Mercado Pago — aplicação OAuth (marketplace) ----------
# Painel do MP → Suas integrações → sua aplicação
# Usado pra cada barbearia conectar a conta dela e receber direto.

MP_CLIENT_ID=
MP_CLIENT_SECRET=

# Precisa estar cadastrada IGUAL no painel do MP, em
# "URLs de redirecionamento" (OAuth):
#   https://navalha-virid.vercel.app/api/mp/callback
MP_REDIRECT_URI=http://localhost:3000/api/mp/callback


# ---------- Mercado Pago — conta da própria Navalha ----------
# Recebe a assinatura mensal que as barbearias pagam pelo sistema.

MP_ACCESS_TOKEN=
NEXT_PUBLIC_MP_PUBLIC_KEY=


# ---------- Webhook ----------
# Painel do MP → sua aplicação → Webhooks → informe a URL
#   https://navalha-virid.vercel.app/api/mp/webhook
# O MP gera uma "chave secreta" ao salvar — cole aqui.
# Sem isso qualquer um pode forjar uma confirmação de pagamento.
MP_WEBHOOK_SECRET=


# ---------- Comissão (opcional) ----------
# % que a Navalha retém de cada agendamento pago online.
# 0 = a barbearia recebe tudo.
MP_TAXA_PERCENTUAL=0
